<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MaiDroid" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/home_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/main_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- API 26 没有这个属性，系统会忽略；27 起导航栏用浅色图标 -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>
