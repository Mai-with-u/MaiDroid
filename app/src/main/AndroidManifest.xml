<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：下载 MaiBot 及依赖、访问大模型服务和 QQ，宿主访问容器里的 WebUI -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务：托管容器里的长驻进程，常驻通知；specialUse 避免 Android 15+ dataSync 6 小时超时和开机自启受限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 保活：唤醒锁、电池优化白名单、开机自启 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 悬浮窗：用于「扩展组件」中的本机悬浮桌宠在其他应用上层显示 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 触觉反馈：底部导航栏与液态玻璃滑块跨越选项时触发短促震动（自适应线性马达与转子马达） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 应用自更新：把下载好的新版本安装包交给系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 存储（可选）：按需让容器挂载 /sdcard 访问手机文件，后续也供外部备份使用；Android 11 起用“所有文件访问”，旧系统用读写外部存储，见 SystemPermissionController -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".MaiDroidApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaiDroid"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:theme="@style/Theme.MaiDroid"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WebUiActivity"
            android:exported="false"
            android:theme="@style/Theme.MaiDroid"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- 悬浮桌宠探索记录全屏页 -->
        <activity
            android:name=".pet.PetRecordsActivity"
            android:exported="false"
            android:theme="@style/Theme.MaiDroid"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- 托管 MaiBot、NapCat、SnowLuma、容器 sshd 的前台服务：用 specialUse 承载本地常驻运行时，不设 6 小时运行上限 -->
        <service
            android:name=".service.MaiBotRuntimeService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_bot_container_runtime" />
        </service>

        <!-- 本机悬浮桌宠前台服务：由用户在「扩展组件」手动开启，关闭时不随容器常驻 -->
        <service
            android:name=".pet.PetOverlayService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="local_floating_desktop_pet" />
        </service>

        <!-- 把容器里的文件经 SAF 共享给系统“文件”应用、MT 管理器等；MANAGE_DOCUMENTS 保证只有系统文件框架能直接调用 -->
        <provider
            android:name=".files.ContainerDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- 应用自更新：只把 cacheDir/app-update/ 里下载好的安装包临时授权给系统安装器读取 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.appupdate"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/app_update_paths" />
        </provider>

        <!-- 开机自启 / 覆盖安装后自动恢复：OOBE 完成且没关自启时拉起前台服务 -->
        <receiver
            android:name=".service.RuntimeAutoStartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 每日自动备份离线兜底：使用系统持久化 JobScheduler，不依赖应用常驻 -->
        <service
            android:name=".backup.AutoBackupJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

    </application>

</manifest>
